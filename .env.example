# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=npms_db
DB_USER=npms_user
DB_PASSWORD=npms_local_pass_2026

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP=localhost:9092

# SMTP (Gmail example; use a Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-account@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# JWT (RSA keys path)
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# MFA secret-at-rest encryption (AES-256, base64, 32 raw bytes).
# Generate your own with: openssl rand -base64 32
# NEVER reuse the value from an example/template in a real deployment.
MFA_SECRET_ENC_KEY=

# IP-based throttle on auth endpoints (login, forgot-password, verify-otp, ...)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# App
APP_BASE_URL=http://localhost:3000
# Use APP_ENV=production (or anything other than "local") to mark cookies
# Secure — this only works correctly if the app is actually served over HTTPS.
APP_ENV=local
